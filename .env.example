# Copy to .env and fill in. .env is gitignored.

# Discord bot token (Bot -> Reset Token in the Developer Portal)
DISCORD_TOKEN=

# Comma-separated Discord user IDs allowed to control the bot.
# Everyone else is ignored. Enable Developer Mode in Discord, right-click your
# avatar -> Copy User ID.
OWNER_IDS=

# Optional: a single guild (server) ID. If set, slash commands sync to that
# guild instantly instead of taking up to an hour globally. Recommended.
GUILD_ID=

# Default working directory for new sessions when /new is called without a cwd.
DEFAULT_CWD=/Users/you/code

# Comma-separated tools auto-approved without a Discord prompt.
# Everything else routes to Approve/Deny buttons. Read-only defaults:
AUTO_APPROVE_TOOLS=Read,Glob,Grep,NotebookRead,TodoWrite

# Optional model override passed to Claude Code (e.g. "sonnet", "opus",
# "claude-sonnet-5"). Leave blank to use Claude Code's default.
MODEL=

# Where the SQLite session store lives (gitignored).
DB_PATH=sessions.db

# Seconds to wait for a tool-approval button click before auto-denying.
APPROVAL_TIMEOUT=300
