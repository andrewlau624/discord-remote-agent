# Copy to .env and fill in. .env is gitignored. Behavior settings live in
# config.toml, not here.

# Discord bot token (Bot -> Reset Token in the Developer Portal)
DISCORD_TOKEN=

# Only the owner of the Discord server can control the bot. Nothing to set here.

# Optional single guild (server) ID. If set, slash commands sync to that guild
# instantly instead of taking up to an hour globally. Recommended.
GUILD_ID=
